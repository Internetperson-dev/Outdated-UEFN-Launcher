#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/uefn-installer"
CONFIG_FILE="$CONFIG_DIR/config"
LAUNCH_OPTIONS_FILE="$CONFIG_DIR/launch-options"

mkdir -p "$CONFIG_DIR"

# Read a value from the config file. Returns 1 if not set.
cfg_get() {
    local key="$1"
    if [[ -f "$CONFIG_FILE" ]] && grep -q "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
        grep "^${key}=" "$CONFIG_FILE" | head -1 | cut -d= -f2-
        return 0
    fi
    return 1
}

# Write/update a value in the config file.
cfg_set() {
    local key="$1" val="$2"
    if [[ -f "$CONFIG_FILE" ]] && grep -q "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
        # Use a temp file for atomic replace (sed -i can't handle / in paths)
        local tmp="${CONFIG_FILE}.tmp.$$"
        grep -v "^${key}=" "$CONFIG_FILE" > "$tmp"
        printf '%s=%s\n' "$key" "$val" >> "$tmp"
        mv "$tmp" "$CONFIG_FILE"
    else
        printf '%s=%s\n' "$key" "$val" >> "$CONFIG_FILE"
    fi
}

# Remove a key from the config file.
cfg_delete() {
    local key="$1"
    if [[ -f "$CONFIG_FILE" ]] && grep -q "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
        local tmp="${CONFIG_FILE}.tmp.$$"
        grep -v "^${key}=" "$CONFIG_FILE" > "$tmp"
        mv "$tmp" "$CONFIG_FILE"
    fi
}

# If the launch-options file does not exist, create it with a default,
# commented list of command-line options (Steam-style). '#' starts a comment;
# everything else is collected into a single command line at launch.
ensure_launch_options_file() {
    if [[ -f "$LAUNCH_OPTIONS_FILE" ]]; then
        return
    fi

    cat > "$LAUNCH_OPTIONS_FILE" <<'EOF'
# Launch options for UEFN, Steam-style.
#
# %command% is the place where the game binary will be inserted.
# Put launcher/passthrough tools BEFORE it, UEFN arguments AFTER it.
#
# Everything that follows %command% is optional.
#
# UEFN/passthrough arguments:
#
# -fullscreen
#     Launch in fullscreen.
#
# -windowed
#     Launch in windowed mode.
#
# -ResX=1920 -ResY=1080
#     Windowed resolution.
#
# -NOSPLASH
#     Skip the Unreal splash screen.
#
# -FullStdout
#     Print all engine logs to this terminal.
#
# -log
#     Verbose engine logging.
#
# -unattended
#     Bypass dialogs (no extra prompts).
#
# -d3d11, -d3d12
#     Force DirectX 11 or 12.
#
# Async drivers (DX11/DX12->Vulkan on compatible GPUs):
# -dx11vk
#     Translate DirectX 11 calls to Vulkan.
#
# -vkd3d
#     Translate DirectX 12 calls to Vulkan via DXVK.
#
# -esync -noesync
#     Force or disable Esync.
#
# Tools that must come BEFORE %command%:
#
# gamemoderun
#     Boost game performance if GameMode (libgamemode) is installed.
#
# mangohud
#     Show the MangoHud overlay if installed.
#
# Example command line (uncomment to use):
#
# gamemoderun mangohud %command% -fullscreen

%command%
EOF

    info "Created launch options file:"
    echo "  $LAUNCH_OPTIONS_FILE"
}

# Open the launch options file in an editor so the user can tweak/customize it.
edit_launch_options() {
    ensure_launch_options_file

    local editor="${VISUAL:-${EDITOR:-}}"
    if [[ -z "$editor" ]]; then
        if command -v nano &>/dev/null; then
            editor="nano"
        elif command -v vim &>/dev/null; then
            editor="vim"
        elif command -v vi &>/dev/null; then
            editor="vi"
        fi
    fi

    if [[ -z "$editor" ]]; then
        info "No editor found. Open the file manually:"
        echo "  $LAUNCH_OPTIONS_FILE"
        return
    fi

    info "Opening launch options in $editor :"
    echo "  $LAUNCH_OPTIONS_FILE"
    echo
    "$editor" "$LAUNCH_OPTIONS_FILE"
}

# Return the full launch-options command line (comments/blank lines removed).
# All non-comment text is joined into a single line, Steam-style.
# Parses launch options file: handles leading '-' on env vars, exports them,
# strips inline comments, and returns game arguments / wrapper commands.
get_launch_command() {
    local line out=""
    [[ ! -f "$LAUNCH_OPTIONS_FILE" ]] && return 1

    while IFS= read -r line || [[ -n "$line" ]]; do
        # 1. Strip inline comments starting with '#'
        line="${line%%#*}"

        # 2. Trim leading and trailing whitespace
        line="$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

        # Skip empty lines
        [[ -z "$line" ]] && continue

        # 3. Handle environment variables (matches both KEY=VAL and -KEY=VAL)
        if [[ "$line" =~ ^-?[A-Za-z_][A-Za-z0-9_]*= ]]; then
            # Strip leading '-' if present
            local env_pair="${line#-}"
            local key="${env_pair%%=*}"
            local val="${env_pair#*=}"

            # Strip surrounding quotes if user added them
            val="${val%\"}"
            val="${val#\"}"
            val="${val%\'}"
            val="${val#\'}"

            # Export the environment variable for Proton/Wine to inherit
            export "$key=$val"
            continue
        fi

        out="$out $line"
    done < "$LAUNCH_OPTIONS_FILE"

    [[ -z "$out" ]] && return 1
    echo "$out"
}

build_launch_args() {
    local exe="$1"
    local raw_cmd

    if ! raw_cmd="$(get_launch_command || true)" || [[ -z "$raw_cmd" ]]; then
        echo "PRE"
        echo "POST"
        echo "$exe"
        return 0
    fi

    local pre=() post=()
    local has_command_marker=0
    local in_post=0
    local arg

    if [[ "$raw_cmd" == *"%command%"* ]]; then
        has_command_marker=1
    fi

    for arg in $raw_cmd; do
        if [[ "$arg" == "%command%" ]]; then
            in_post=1
            continue
        fi

        if (( has_command_marker )); then
            if (( in_post )); then
                post+=("$arg")
            else
                pre+=("$arg")
            fi
        else
            # Without %command%: any non-env line starting with '-' is a game flag
            if [[ "$arg" == -* ]]; then
                post+=("$arg")
            else
                pre+=("$arg")
            fi
        fi
    done

    echo "PRE"
    for arg in "${pre[@]}"; do
        echo "$arg"
    done
    echo "POST"
    echo "$exe"
    for arg in "${post[@]}"; do
        echo "$arg"
    done
}

###############################################################################
# UEFN Installer / Runner
#
# Usage:
#   ./uefn.sh
#   ./uefn.sh install
#   ./uefn.sh launch
#
# Layout:
#   <base>/
#       Fortnite/
#       UEFN/
#       proton-prefix/
#       bin/
#
# The base directory can be anywhere, including an external drive.
###############################################################################

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
LEGENDARY="$SCRIPT_DIR/legendary_linux_x86_64"

###############################################################################
# Colours
###############################################################################

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
RESET='\033[0m'

info() {
    echo -e "${BLUE}[INFO]${RESET} $*"
}

success() {
    echo -e "${GREEN}[OK]${RESET} $*"
}

warn() {
    echo -e "${YELLOW}[WARN]${RESET} $*"
}

error() {
    echo -e "${RED}[ERROR]${RESET} $*" >&2
}

###############################################################################
# Find Legendary
###############################################################################

# Legendary source of truth: a local copy next to this script is preferred so
# the whole toolchain is self-contained. We pin a known-good release for the
# offline toolchain but query GitHub for updates at runtime.
LEGENDARY_REPO="Heroic-Games-Launcher/legendary"
LEGENDARY_API="https://api.github.com/repos/${LEGENDARY_REPO}/releases/latest"
LEGENDARY_ASSET="legendary_linux_x86_64"
# Fetched dynamically (see legendary_latest_release) to avoid hardcoding.

# Resolve the legendary binary we will use. Priority:
#   1. A pinned/local copy placed next to this script ($LEGENDARY).
#   2. `legendary` already on PATH.
# Sets $LEGENDARY and returns 1 if none can be made available.
resolve_legendary() {
    if [[ -x "$LEGENDARY" ]]; then
        return 0
    fi
    if command -v legendary &>/dev/null; then
        LEGENDARY="$(command -v legendary)"
        return 0
    fi
    return 1
}

# Print the installed legendary version string, e.g. "0.20.43", or empty.
legendary_local_version() {
    [[ -x "$LEGENDARY" ]] || return 0
    "$LEGENDARY" --version 2>/dev/null | sed -nE 's/.*"([0-9]+\.[0-9]+\.[0-9]+)".*/\1/p' | head -1
}

# Query GitHub for the latest release. Returns version + sha256 (space separated)
# or empty on failure (offline, rate-limited, etc).
legendary_latest_release() {
    local json
    json="$(curl -fsSL --connect-timeout 8 --max-time 20 "$LEGENDARY_API" 2>/dev/null)" || return 1

    local tag digest url
    tag="$(   echo "$json" | jq -r '.tag_name' 2>/dev/null)"
    digest="$(echo "$json" | jq -r --arg a "$LEGENDARY_ASSET" '.assets[] | select(.name==$a) | .digest' 2>/dev/null | sed 's/^sha256://')"
    url="$(    echo "$json" | jq -r --arg a "$LEGENDARY_ASSET" '.assets[] | select(.name==$a) | .browser_download_url' 2>/dev/null)"

    if [[ -z "$tag" || -z "$digest" || -z "$url" ]]; then
        return 1
    fi

    echo "$tag|$digest|$url"
}

# Verify (and optionally fix the exec bit of) a legendary binary against an
# expected sha256. $1 = path, $2 = expected sha256 (may be empty to skip).
verify_legendary_hash() {
    local path="$1" expected="$2"
    if [[ -z "$expected" || ! -f "$path" ]]; then
        return 0
    fi
    local actual
    actual="$(sha256sum "$path" 2>/dev/null | awk '{print $1}')"
    [[ -n "$actual" && "$actual" == "$expected" ]]
}

# Download the latest legendary into $LEGENDARY and verify its hash.
download_legendary() {
    local url="$1" expected="$2"
    local tmp
    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' RETURN

    info "Downloading legendary ($LEGENDARY_ASSET)..."
    if ! curl -fsSL --connect-timeout 10 --max-time 300 -o "$tmp" "$url"; then
        error "Failed to download legendary."
        rm -f "$tmp"
        return 1
    fi

    if ! verify_legendary_hash "$tmp" "$expected"; then
        error "Legendary checksum mismatch; refusing to use the binary."
        rm -f "$tmp"
        return 1
    fi

    chmod +x "$tmp"
    mkdir -p "$(dirname "$LEGENDARY")"
    if mv -f "$tmp" "$LEGENDARY"; then
        success "legendary installed: $LEGENDARY"
        rm -f "$tmp"
    else
        error "Failed to move legendary into place."
        rm -f "$tmp"
        return 1
    fi
}

# Top-level entry. Ensures a usable, up-to-date, checksum-verified legendary is
# available. Returns 1 if legendary is neither usable nor installable.
ensure_legendary() {
    local local_version latest
    local -a latest_parts=()

    if resolve_legendary; then
        local_version="$(legendary_local_version)"

        if latest="$(legendary_latest_release 2>/dev/null)"; then
            IFS='|' read -ra latest_parts <<<"$latest"
            local latest_tag="${latest_parts[0]}"
            local latest_digest="${latest_parts[1]:-}"
            local latest_url="${latest_parts[2]:-}"

            if [[ -z "$local_version" ]]; then
                # Installed copy exists but reports no version; update to be safe.
                info "No version detected locally; refreshing legendary."
                download_legendary "$latest_url" "$latest_digest"
            elif version_gt "$latest_tag" "$local_version" || \
                 ! verify_legendary_hash "$LEGENDARY" "$latest_digest"; then
                if [[ "$latest_tag" != "$local_version" ]]; then
                    info "legendary update available: $local_version -> $latest_tag"
                else
                    info "legendary hash does not match latest release; refreshing."
                fi
                download_legendary "$latest_url" "$latest_digest"
                return 0
            fi
        fi

        # Online check unavailable (offline/rate-limited): rely on the local copy.
        return 0
    fi

    # No legendary anywhere: try to download the latest from GitHub.
    warn "legendary is not installed. Attempting to download it..."
    if latest="$(legendary_latest_release 2>/dev/null)"; then
        IFS='|' read -ra latest_parts <<<"$latest"
        download_legendary "${latest_parts[2]}" "${latest_parts[1]:-}"
        return $?
    fi

    error "Could not reach GitHub to obtain legendary."
    error "Place '${LEGENDARY_ASSET}' next to this script or install 'legendary' on your PATH."
    return 1
}

# Diagnostic: show legendary status (version, hash, latest available).
legendary_status() {
    echo "Legendary:"
    echo
    if resolve_legendary; then
        echo "  Binary:    $LEGENDARY"
        echo "  Version:   $(legendary_local_version || echo unknown)"
        echo
        if latest="$(legendary_latest_release 2>/dev/null)"; then
            local -a lp=()
            IFS='|' read -ra lp <<<"$latest"
            local latest_tag="${lp[0]}" latest_digest="${lp[1]:-}"
            local lv
            lv="$(legendary_local_version || true)"
            echo "  Latest:    $latest_tag"
            if [[ -n "$lv" ]] && version_gt "$latest_tag" "$lv"; then
                warn "  -> An update is available ($lv -> $latest_tag)."
            elif [[ -n "$lv" ]]; then
                echo "  -> Up to date."
            fi
            if verify_legendary_hash "$LEGENDARY" "$latest_digest"; then
                echo "  Hash:      matches latest release (OK)"
            else
                warn "  Hash:      does NOT match the latest release."
            fi
        else
            echo "  Latest:    (could not reach GitHub)"
            if verify_legendary_hash "$LEGENDARY" ""; then
                :
            fi
        fi
    else
        echo "  Binary:    NOT installed"
        echo "  Status:    will be downloaded on first need."
        echo
        local -a lp=()
        if latest="$(legendary_latest_release 2>/dev/null)"; then
            IFS='|' read -ra lp <<<"$latest"
            echo "  Latest:    ${lp[0]}"
        else
            echo "  Latest:    (could not reach GitHub)"
        fi
    fi
}

# Semver-style compare: returns 0 if $1 > $2 (e.g. 0.20.43 > 0.20.42).
# Works on dotted numeric versions like "0.20.43". Any non-numeric suffix
# (e.g. "0.20.43-rc1") is ignored, which is fine for update checks.
version_gt() {
    local a="$1" b="$2"
    [[ "$a" != "$b" ]] || return 1

    # Extract only the numeric components, then left-pad each to 3 digits and
    # concatenate so the padded strings compare correctly as numbers.
    local pa pb
    pa="$(version_pad "$a")"
    pb="$(version_pad "$b")"
    (( 10#$pa > 10#$pb ))
}

version_pad() {
    local v="$1" nums p=""
    nums="$(tr -dc '0-9.' <<<"$v")"
    local part
    IFS='.' read -ra parts <<<"$nums"
    for ((i = 0; i < 4; i++)); do
        if (( i < ${#parts[@]} )); then
            part="${parts[i]}"
        else
            part="0"
        fi
        printf -v p "%s%03d" "$p" "${part:-0}"
    done
    echo "$p"
}

###############################################################################
# Memory: ZRAM + swap recommendations
###############################################################################

# Total physical RAM in MiB (best effort; falls back to 0). /proc/meminfo is
# in kB, so the raw value is converted to MiB.
total_ram_mib() {
    local kb
    kb="$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null)" || return 0
    (( kb > 0 )) && awk -v k="$kb" 'BEGIN{printf "%d", k/1024}'
}

total_swap_mib() {
    local kb
    kb="$(awk '/^SwapTotal:/{print $2}' /proc/meminfo 2>/dev/null)" || return 0
    (( kb > 0 )) && awk -v k="$kb" 'BEGIN{printf "%d", k/1024}'
}

# Detect an existing zram swap device in use (e.g. /dev/zram0). Prints the
# device name if found, else empty.
existing_zram_swap() {
    command -v swapon >/dev/null 2>&1 || return 0
    swapon --show --noheadings 2>/dev/null | awk '$1 ~ /^\/dev\/zram[0-9]+$/ {print $1; exit}'
}

# True (0) if sudo is present, else 1. (An actual sudo call may prompt for a
# password; we defer that to the real operation.)
have_sudo() {
    command -v sudo >/dev/null 2>&1
}

# Show current memory situation and ZRAM/swap recommendations.
memory_status() {
    local ram_mib swap_mib
    ram_mib="$(total_ram_mib)"
    swap_mib="$(total_swap_mib)"
    local ram_g swap_g
    ram_g="$(awk -v m="$ram_mib" 'BEGIN{printf "%.1f", m/1024}')"
    swap_g="$(awk -v m="$swap_mib" 'BEGIN{printf "%.1f", m/1024}')"

    echo "========================================="
    echo " Memory & Swap"
    echo "========================================="
    echo
    echo "RAM:          $ram_mib MiB ($ram_g GiB)"
    echo "Swap total:   $swap_mib MiB ($swap_g GiB)"
    echo
    echo "Swap devices:"
    local line
    if command -v swapon >/dev/null 2>&1 && output="$(swapon --show 2>&1)"; then
        echo "$output" | while IFS= read -r line; do
            echo "  $line"
        done
    else
        echo "  (none)"
    fi
    echo

    local zram_dev
    zram_dev="$(existing_zram_swap)"
    if [[ -n "$zram_dev" ]]; then
        success "ZRAM swap is active ($zram_dev)."
        echo
        local zsize
        zsize="$(zramctl -o NAME,DISKSIZE,DATA,COMPR,ALGORITHM 2>/dev/null | awk '$1 ~ /^\/dev\/zram/ {print; exit}')"
        [[ -n "$zsize" ]] && echo "  $zsize"
    else
        warn "No ZRAM swap configured."
    fi
    echo

    # Recommendation based on the presence of an existing zram solution.
    if [[ -z "$zram_dev" ]]; then
        echo "Recommendation:"
        if (( ram_mib < 32768 )); then
            echo "  You have less than 32GB of RAM. A RAM disk / swap can help."
            echo "  Use ZRAM (compressed in-RAM swap) or a disk swapfile:"
            echo "    - ZRAM: 25-80% of RAM, ZSTD compression (see menu option)."
            echo "    - Swap: 10-30GB disk swapfile if you also need fallback."
            recommend_zram_choices
        else
            echo "  You have >= 32GB of RAM; ZRAM is optional."
            echo "  Configure ZRAM via this menu if you want compressed swap."
        fi
    else
        echo "ZRAM is already set up; leaving it as-is."
    fi
    echo
}

# Print the suggested ZRAM percents for guidance.
recommend_zram_choices() {
    local ram_mib
    ram_mib="$(total_ram_mib)"
    local low high
    low="$(awk -v m="$ram_mib" 'BEGIN{printf "%.1f", m*0.25/1024}')"
    high="$(awk -v m="$ram_mib" 'BEGIN{printf "%.1f", m*0.80/1024}')"
    echo "  Suggested ZRAM size: $low - $high GiB (25-80% of $((ram_mib/1024)) GiB RAM)."
}

# Configure ZRAM as swap with ZSTD compression. $1 = percent of RAM (20-80),
# default CLI arg. Does NOT touch an existing zram swap.
zram_setup() {
    local percent="${1:-25}"
    local ram_mib
    ram_mib="$(total_ram_mib)"
    if (( ram_mib <= 0 )); then
        error "Could not determine total RAM."
        return 1
    fi

    # Refuse to clobber an existing zram swap on OTHER systems too, matching
    # the "keep existing solution" behaviour.
    local existing
    if existing="$(existing_zram_swap)"; then
        success "ZRAM swap already active ($existing). Not modifying it."
        return 0
    fi

    if ! have_sudo; then
        error "Root is required to set up ZRAM (sudo) but is not available."
        return 1
    fi

    # Clamp percent to [20,80].
    if (( percent < 20 )); then percent=20; fi
    if (( percent > 80 )); then percent=80; fi

    local size_mib
    size_mib="$(awk -v m="$ram_mib" -v p="$percent" 'BEGIN{printf "%d", m*p/100}')"
    local size_bytes
    size_bytes="$(( size_mib * 1024 * 1024 ))"

    echo "Setting up ZRAM (${percent}% = ${size_mib} MiB) with ZSTD compression..."
    echo

    # Load module.
    sudo modprobe zram || { error "Failed to load zram module."; return 1; }

    # Create the zram device config inside a single root shell so all the
    # /sys writes are consistent. Prefer /dev/zram0 when it is not already in
    # use as swap; otherwise hot-add a fresh device.
    local result
    result="$(sudo bash -s -- "$size_bytes" <<'ROOTSH'
set -e
size_bytes="$1"

# Find a free zram device.
if [[ ! -e /dev/zram0 ]] || ! swapon --show --noheadings 2>/dev/null | grep -q '^/dev/zram0 '; then
    DEV=/dev/zram0
else
    NUM=$(cat /sys/class/zram-control/hot_add 2>/dev/null || echo 1)
    DEV=/dev/zram${NUM}
fi

# Reset any prior config on this device, then set size + zstd.
if [[ -e /sys/block/${DEV#/dev}/reset ]]; then
    echo 1 > /sys/block/${DEV#/dev}/reset
fi
if [[ -e /sys/block/${DEV#/dev}/comp_algorithm ]]; then
    echo zstd > /sys/block/${DEV#/dev}/comp_algorithm
fi
echo "$size_bytes" > /sys/block/${DEV#/dev}/disksize

mkswap "$DEV" >/dev/null
swapon "$DEV" -p 100
printf '%s' "$DEV"
ROOTSH
)" || { error "Failed to set up ZRAM."; return 1; }

    echo
    success "ZRAM swap enabled: $result (${size_mib} MiB, zstd, priority 100)."
    echo
    free -h
}

# Tear down ZRAM swap that this script (or any) configured. Requires sudo.
zram_teardown() {
    local dev
    if ! dev="$(existing_zram_swap)"; then
        info "No ZRAM swap to disable."
        return 0
    fi

    if ! have_sudo; then
        error "Root is required to disable ZRAM (sudo) but is not available."
        return 1
    fi

    read -r -p "Disable ZRAM swap device $dev? [y/N] " ans
    ans="${ans:-N}"
    if [[ ! "$ans" =~ ^[Yy]$ ]]; then
        echo "Cancelled."
        return 0
    fi

    sudo swapoff "$dev" || { error "swapoff failed."; return 1; }
    local num="${dev#/dev/zram}"
    if [[ -e /sys/class/zram-control/hot_remove ]]; then
        sudo bash -c "echo $num > /sys/class/zram-control/hot_remove" 2>/dev/null || true
    fi
    success "ZRAM swap disabled ($dev)."
}

# Interactive menu for memory/ZRAM configuration.
memory_menu() {
    while true; do
        clear
        echo "========================================="
        echo " Memory / Swap"
        echo "========================================="
        echo "1) Show status + recommendation"
        echo "2) Set up ZRAM swap (25-80% of RAM, ZSTD)"
        echo "3) Disable ZRAM swap"
        echo "4) Auto-setup (livecd machine: 15G zram + 50G USB swap)"
        echo "5) Back to main menu"
        echo
        read -r -p "Select an option [1-5]: " mm || true
        case "$mm" in
            1) echo; memory_status; read -r -p "Press Enter to continue...";;
            2)
                echo
                recommend_zram_choices
                echo
                read -r -p "ZRAM percent of RAM (20-80, default 25): " pct
                pct="${pct:-25}"
                if [[ "$pct" =~ ^[0-9]+$ ]]; then
                    zram_setup "$pct"
                else
                    error "Invalid percent."
                fi
                read -r -p "Press Enter to continue..."
                ;;
            3) echo; zram_teardown; read -r -p "Press Enter to continue...";;
            4) echo; ensure_livecd_memory; read -r -p "Press Enter to continue...";;
            5) return 0;;
            *) warn "Invalid selection."; sleep 1;;
        esac
    done
}

# Optional banner shown at install/launch time: reminds users with < 32GB of
# RAM about ZRAM / a disk swap. No-op otherwise.
memory_recommendation() {
    local ram_mib
    ram_mib="$(total_ram_mib)"
    (( ram_mib < 32768 )) || return 0

    echo
    warn "You have less than 32GB of RAM ($((ram_mib/1024)) GiB)."
    echo "  Consider ZRAM (menu option 5) or a 10-30GB disk swapfile."
    echo
}

# Machine-specific auto-setup for the author's LiveCD box (user 'livecd', ~23-24
# GiB of RAM). Ensures the preferred swap setup on that machine:
#   * 15G ZSTD-compressed ZRAM swap (zram0)
#   * a 50G USB swapfile at /mnt/usb/swapfile (USB auto-mounted if needed)
# On any other machine, or when the setup is already present, this is a no-op.
ensure_livecd_memory() {
    [[ "$(whoami 2>/dev/null)" == "livecd" ]] || return 0

    local ram_mib
    ram_mib="$(total_ram_mib)"
    # Roughly 23-24 GiB (this machine); be a little tolerant of size reports.
    (( ram_mib >= 22528 && ram_mib <= 26624 )) || return 0

    # --- ZRAM: 15G, zstd, priority 100 ---
    if [[ -z "$(existing_zram_swap)" ]]; then
        info "Setting up 15G ZRAM swap (livecd machine)..."
        if have_sudo; then
            sudo modprobe zram
            sudo zramctl --find --size 15G --algorithm zstd
            sudo mkswap /dev/zram0 >/dev/null
            sudo swapon --priority 100 /dev/zram0
            success "ZRAM swap enabled (/dev/zram0, 15G, zstd)."
        else
            warn "sudo is required to set up ZRAM."
        fi
    fi

    # --- USB swapfile: 50G at /mnt/usb/swapfile ---
    # Auto-mount the USB if it is not already at /mnt/usb.
    if ! mountpoint -q /mnt/usb 2>/dev/null; then
        info "Mounting USB to /mnt/usb..."
        if have_sudo && [[ -b /dev/sdc2 ]]; then
            sudo mkdir -p /mnt/usb
            sudo mount /dev/sdc2 /mnt/usb || warn "Could not mount /dev/sdc2 to /mnt/usb."
        else
            warn "Cannot auto-mount /mnt/usb (missing sudo or device)."
        fi
    fi

    if [[ -d /mnt/usb ]]; then
        local sf="/mnt/usb/swapfile"
        if [[ ! -f "$sf" ]]; then
            info "Creating 50G swapfile at $sf..."
            if have_sudo; then
                sudo fallocate -l 50G "$sf"
                sudo chmod 600 "$sf"
                sudo mkswap "$sf" >/dev/null
                sudo swapon "$sf"
                success "USB swapfile enabled (50G)."
            else
                warn "sudo is required to create the USB swapfile."
            fi
        elif ! sudo swapon --show --noheadings 2>/dev/null | grep -q "$sf"; then
            info "Enabling existing swapfile $sf..."
            if have_sudo; then
                sudo swapon "$sf"
                success "USB swapfile enabled (50G)."
            else
                warn "sudo is required to enable the USB swapfile."
            fi
        fi
    else
        warn "/mnt/usb is not available; skipping 50G USB swapfile."
    fi
}

###############################################################################
# Installation directory
###############################################################################

BASE_DIR=""

choose_base_dir() {
    # Use the previously saved directory if it exists.
    # Supports both old format (plain path) and new key=value format.
    if [[ -f "$CONFIG_FILE" ]]; then
        if BASE_DIR="$(cfg_get base_dir)"; then
            : # got it from key=value format
        else
            # Old format: first non-empty line is the path
            BASE_DIR="$(head -1 "$CONFIG_FILE")"
        fi

        if [[ -n "$BASE_DIR" && -d "$BASE_DIR" ]]; then
            return 0
        fi
    fi

    echo
    echo "========================================="
    echo " UEFN Installation Directory"
    echo "========================================="
    echo
    echo "Enter the directory where Fortnite and UEFN should be installed."
    echo
    echo "Example:"
    echo "  ~/UEFN"
    echo

    read -r -p "Install directory: " BASE_DIR

    # Expand ~
    BASE_DIR="${BASE_DIR/#\~/$HOME}"

    if [[ -z "$BASE_DIR" ]]; then
        error "No directory supplied."
        exit 1
    fi

    BASE_DIR="$(realpath -m "$BASE_DIR")"

    mkdir -p "$BASE_DIR"

    # Save for future launches.
    cfg_set base_dir "$BASE_DIR"

    success "Installation directory saved:"
    echo "  $BASE_DIR"
}

###############################################################################
# Proton discovery
###############################################################################

find_proton() {
    # Check cached path first — avoids filesystem scans entirely.
    local cached
    if cached="$(cfg_get proton_path)" && [[ -x "$cached" ]]; then
        echo "$cached"
        return 0
    fi

    # Launch all find scans in parallel. Each writes its results to a temp file.
    local tmpdir
    tmpdir="$(mktemp -d)"
    local pids=()

    # Scan 1: compatibilitytools.d directories (depth 2)
    {
        for dir in \
            "$HOME/.steam/steam/compatibilitytools.d" \
            "$HOME/.steam/root/compatibilitytools.d" \
            "$HOME/.local/share/Steam/compatibilitytools.d" \
            "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/compatibilitytools.d" \
            "$HOME/.var/app/com.valvesoftware.Steam/data/Steam/compatibilitytools.d"
        do
            [[ -d "$dir" ]] || continue
            find "$dir" -mindepth 2 -maxdepth 2 -type f -name proton -perm -u+x \
                -print 2>/dev/null
        done
    } > "$tmpdir/compat" & pids+=($!)

    # Scan 2: Steam library common dirs (depth 3)
    {
        for dir in \
            "$HOME/.steam/steam/steamapps/common" \
            "$HOME/.steam/root/steamapps/common" \
            "$HOME/.local/share/Steam/steamapps/common" \
            "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common"
        do
            [[ -d "$dir" ]] || continue
            find "$dir" -mindepth 3 -maxdepth 3 -type f -path '*/proton' -perm -u+x \
                -print 2>/dev/null
        done
    } > "$tmpdir/common" & pids+=($!)

    wait "${pids[@]}" 2>/dev/null || true

    # Merge + deduplicate
    local found
    mapfile -t found < <(
        cat "$tmpdir/compat" "$tmpdir/common" 2>/dev/null |
        sort -u |
        grep -v '^$'
    )
    rm -rf "$tmpdir"

    if (( ${#found[@]} == 0 )); then
        return 1
    fi

    # Prefer known Proton distributions.
    local proton
    for proton in "${found[@]}"; do
        case "$proton" in
            *GE-Proton*|*Proton-CachyOS*|*Proton-*|*"/Proton "*)
                cfg_set proton_path "$proton"
                echo "$proton"
                return 0
                ;;
        esac
    done

    # Fallback
    cfg_set proton_path "${found[-1]}"
    echo "${found[-1]}"
}

###############################################################################
# Show Proton
###############################################################################

get_proton() {
    local proton

    if ! proton="$(find_proton)"; then
        return 1
    fi

    [[ -x "$proton" ]] || return 1

    echo "$proton"
}

###############################################################################
# Install Core Fonts
###############################################################################

install_core_fonts() {
    local prefix="$1"
    local pfx_dir="$prefix/pfx"
    local font_marker="$prefix/.corefonts_installed"

    if [[ -f "$font_marker" ]]; then
        info "Core fonts already installed."
        return 0
    fi

    info "Installing Core Fonts into Wine prefix..."

    # Ensure dependencies (curl and cabextract are required for winetricks corefonts)
    if ! command -v curl &>/dev/null; then
        error "curl is required to install core fonts but is not installed."
        return 1
    fi

    if ! command -v cabextract &>/dev/null; then
        warn "'cabextract' is not installed. Installing core fonts might fail if cabextract is required."
    fi

    local winetricks="/tmp/winetricks"

    info "Downloading winetricks..."
    curl -sSL -o "$winetricks" https://raw.githubusercontent.com/Winetricks/winetricks/master/src/winetricks
    chmod +x "$winetricks"

    # Winetricks needs to point to the inner pfx folder if using Steam Proton paths
    if [[ -d "$pfx_dir" ]]; then
        WINEPREFIX="$pfx_dir" "$winetricks" -q corefonts || true
    else
        WINEPREFIX="$prefix" "$winetricks" -q corefonts || true
    fi

    touch "$font_marker"
    success "Core fonts installed successfully."
}

###############################################################################
# Authentication
###############################################################################

ensure_auth() {
    info "Checking Legendary authentication..."

    ensure_legendary || exit 1

    if "$LEGENDARY" status >/dev/null 2>&1; then
        success "Already authenticated."
        return 0
    fi

    warn "Legendary is not authenticated."
    echo
    echo "Opening Epic Games authentication..."
    echo

    "$LEGENDARY" auth

    echo

    if "$LEGENDARY" status >/dev/null 2>&1; then
        success "Authentication successful."
    else
        error "Authentication failed."
        exit 1
    fi
}

###############################################################################
# Check and Apply Updates (Fortnite & UEFN)
###############################################################################

check_and_update_apps() {
    info "Checking for Epic Games updates for Fortnite and UEFN..."

    ensure_legendary || exit 1

    local json_output
    json_output="$("$LEGENDARY" list-installed --check-updates --json 2>/dev/null || true)"

    if [[ -z "$json_output" ]]; then
        warn "Could not fetch installed games status from Legendary. Skipping update check."
        return
    fi

    # Check Fortnite update status
    local fortnite_needs_update
    fortnite_needs_update="$(python3 -c '
import json, sys
try:
    data = json.loads(sys.stdin.read())
    for app in data:
        if app.get("app_name") == "Fortnite" and app.get("needs_update"):
            print("true")
            break
except:
    pass
' <<< "$json_output")"

    if [[ "$fortnite_needs_update" == "true" ]]; then
        info "An update is available for Fortnite. Updating..."
        "$LEGENDARY" install Fortnite --update-only
        success "Fortnite updated successfully."
    else
        info "Fortnite is up to date."
    fi

    # Check UEFN (Fortnite_Studio) update status
    local uefn_needs_update
    uefn_needs_update="$(python3 -c '
import json, sys
try:
    data = json.loads(sys.stdin.read())
    for app in data:
        if app.get("app_name") == "Fortnite_Studio" and app.get("needs_update"):
            print("true")
            break
except:
    pass
' <<< "$json_output")"

    if [[ "$uefn_needs_update" == "true" ]]; then
        info "An update is available for UEFN (Fortnite_Studio). Updating..."
        "$LEGENDARY" install Fortnite_Studio --update-only
        success "UEFN updated successfully."
    else
        info "UEFN is up to date."
    fi
}

###############################################################################
# Install
###############################################################################

install_games() {
    choose_base_dir

    memory_recommendation
    ensure_livecd_memory

    local fortnite="$BASE_DIR/Fortnite"
    local uefn="$BASE_DIR/UEFN"

    echo
    echo "========================================="
    echo " Installation"
    echo "========================================="
    echo
    echo "Fortnite:"
    echo "  $fortnite"
    echo
    echo "UEFN:"
    echo "  $uefn"
    echo
    echo "Only the required Fortnite data will be installed."
    echo "HD textures and optional packs will NOT be installed."
    echo

    read -r -p "Continue? [Y/n] " answer
    answer="${answer:-Y}"

    if [[ ! "$answer" =~ ^[Yy]$ ]]; then
        echo "Cancelled."
        exit 0
    fi

    ensure_auth

    mkdir -p "$fortnite" "$uefn"

    echo
    info "Installing Fortnite core files..."
    echo

    "$LEGENDARY" install Fortnite \
        --base-path "$fortnite" \
        --skip-dlcs

    echo
    success "Fortnite installation complete."

    echo
    info "Installing UEFN..."
    echo

    "$LEGENDARY" install Fortnite_Studio \
        --base-path "$uefn"

    echo
    success "UEFN installation complete."

    echo
    echo "========================================="
    echo " Installation complete"
    echo "========================================="
    echo
    echo "Fortnite:"
    echo "  $fortnite"
    echo
    echo "UEFN:"
    echo "  $uefn"
    echo
}

###############################################################################
# Find UEFN executable
###############################################################################

find_uefn_exe() {
    local fortnite_dir="$1"

    # Check cached path first
    local cached
    if cached="$(cfg_get uefn_exe)" && [[ -f "$cached" ]]; then
        echo "$cached"
        return 0
    fi

    # Known absolute path — checked first to skip all searching.
    local known="/mnt/hdd/home/ram/UEFN/Fortnite/Fortnite/FortniteGame/Binaries/Win64/UnrealEditorFortnite-Win64-Shipping.exe"
    if [[ -f "$known" ]]; then
        cfg_set uefn_exe "$known"
        echo "$known"
        return 0
    fi

    local candidates=(
        "$fortnite_dir/Fortnite/Fortnite/FortniteGame/Binaries/Win64/UnrealEditorFortnite-Win64-Shipping.exe"
        "$fortnite_dir/Fortnite/FortniteGame/Binaries/Win64/UnrealEditorFortnite-Win64-Shipping.exe"
        "$fortnite_dir/FortniteGame/Binaries/Win64/UnrealEditorFortnite-Win64-Shipping.exe"
        "$fortnite_dir/UEFN/FortniteGame/Binaries/Win64/UnrealEditorFortnite-Win64-Shipping.exe"
    )

    local exe

    for exe in "${candidates[@]}"; do
        if [[ -f "$exe" ]]; then
            cfg_set uefn_exe "$exe"
            echo "$exe"
            return 0
        fi
    done

    # Fast fallback: check common Binaries/Win64 locations in parallel
    local search_dirs=()
    local sub
    for sub in Fortnite Fortnite/Fortnite FortniteGame UEFN/FortniteGame; do
        local d="$fortnite_dir/$sub/Binaries/Win64"
        if [[ -d "$d" ]]; then
            search_dirs+=("$d")
        fi
    done

    if (( ${#search_dirs[@]} > 0 )); then
        exe="$(
            find "${search_dirs[@]}" \
                -maxdepth 1 \
                -type f \
                -name 'UnrealEditorFortnite-Win64-Shipping.exe' \
                -print -quit 2>/dev/null || true
        )"
    fi

    # Last resort: full recursive search
    if [[ -z "$exe" ]]; then
        exe="$(
            find "$fortnite_dir" \
                -type f \
                -name 'UnrealEditorFortnite-Win64-Shipping.exe' \
                -print -quit 2>/dev/null || true
        )"
    fi

    if [[ -n "$exe" ]]; then
        cfg_set uefn_exe "$exe"
        echo "$exe"
        return 0
    fi

    return 1
}

###############################################################################
# Install VS Code + Verse plugin (Linux and/or Proton prefix)
###############################################################################

find_vscode_dir() {
    local base="$1"
    local candidates=(
        "/mnt/hdd/home/ram/UEFN/Fortnite/Fortnite/VSCode"
        "$base/Fortnite/VSCode"
        "$base/Fortnite/Fortnite/VSCode"
        "$base/VSCode"
    )
    local d
    for d in "${candidates[@]}"; do
        if [[ -d "$d" ]]; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

# Install every .vsix in $1 into extensions dir $2. $3 is the platform
# ('linux' or 'windows'); on Linux the Verse language server binary is made
# executable. extensions.json is deliberately left untouched — VS Code scans
# the extensions folder itself and registers/enables what it finds.
install_vsix_batch() {
    local src_dir="$1"
    local exts_dir="$2"
    local platform="${3:-linux}"

    local vsix tmp folder
    for vsix in "$src_dir"/*.vsix; do
        [[ -f "$vsix" ]] || continue
        info "Installing plugin: $(basename "$vsix")"
        tmp="$(mktemp -d)"
        if ! unzip -q -o "$vsix" -d "$tmp" 2>/dev/null; then
            warn "Failed to unpack $(basename "$vsix")."
            rm -rf "$tmp"
            continue
        fi
        folder="$(
            python3 -c "import json;d=json.load(open('$tmp/extension/package.json'));print(d['publisher']+'.'+d['name']+'-'+d['version'])" 2>/dev/null || true
        )"
        if [[ -z "$folder" || ! -d "$tmp/extension" ]]; then
            warn "Skipping $(basename "$vsix"): not a valid VS Code extension."
            rm -rf "$tmp"
            continue
        fi
        rm -rf "$exts_dir/$folder"
        mv "$tmp/extension" "$exts_dir/$folder"
        rm -rf "$tmp"

        if [[ "$platform" == "linux" ]]; then
            # The Verse language server ships a native Linux binary that must
            # be executable for the plugin to start.
            chmod u+x "$exts_dir/$folder/bin/Linux/verse-lsp" 2>/dev/null || \
                warn "Could not set the execute bit on verse-lsp for $folder."
        fi
        success "Plugin installed: $folder"
    done
}

# Resolve which Linux VS Code to act on ("flatpak" or "native"). Stores the
# choice in the config after asking once. Defaults to native when a native
# binary exists, else Flatpak.
get_vscode_target() {
    local cur
    if cur="$(cfg_get vscode_target 2>/dev/null || true)"; then
        case "$cur" in
            flatpak|native) echo "$cur"; return 0;;
        esac
    fi

    local def="native"
    command -v code code-oss codium code-insiders &>/dev/null || def="flatpak"

    echo
    echo "Which Linux VS Code do you want to use?"
    echo "  1) Native  (code / code-oss / codium / code-insiders)"
    echo "  2) Flatpak (com.visualstudio.code)"
    echo
    local choice
    read -r -p "Choose [1-${def:+2}], default ${def^^}: " choice || true
    case "$choice" in
        1|native|"") cur="native";;
        2|flatpak) cur="flatpak";;
        *) warn "Invalid choice; using native."; cur="native";;
    esac
    cfg_set vscode_target "$cur"
    echo "$cur"
}

# Print the Linux extensions dir + human label for the given target.
linux_vscode_targets() {
    # target|extensions_dir|requires_flatpak|launch_cmd
    case "$1" in
        flatpak)
            echo "flatpak|$HOME/.var/app/com.visualstudio.code/data/vscode/extensions|1|flatpak run com.visualstudio.code";;
        native)
            if [[ -d "$HOME/.vscode/extensions" ]] || command -v code &>/dev/null; then
                echo "native|$HOME/.vscode/extensions|0|code"
            elif command -v code-oss &>/dev/null || [[ -d "$HOME/.vscode-oss/extensions" ]]; then
                echo "native|$HOME/.vscode-oss/extensions|0|code-oss"
            elif command -v codium &>/dev/null; then
                echo "native|$HOME/.vscode-oss/extensions|0|codium"
            elif command -v code-insiders &>/dev/null || [[ -d "$HOME/.vscode-insiders/extensions" ]]; then
                echo "native|$HOME/.vscode-insiders/extensions|0|code-insiders"
            fi
            ;;
    esac
}

# Install the Verse + URC plugins into the Linux VS Code (selected target).
# A VSIX is just a zip: unpack its extension/ folder into the extensions dir
# and let VS Code discover it. extensions.json is never touched, and verse-lsp
# gets chmod u+x.
install_vscode_linux() {
    local vscode_dir="$1"
    local target
    target="$(get_vscode_target)"

    local tinfo
    if ! tinfo="$(linux_vscode_targets "$target")" || [[ -z "$tinfo" ]]; then
        error "No $target VS Code installation detected."
        echo "Install VS Code first, or install the Windows version instead."
        return 1
    fi
    IFS='|' read -r label exts reqflatpak launcher <<<"$tinfo"

    echo
    echo "========================================="
    echo " Installing VS Code + Verse plugin ($label)"
    echo "========================================="
    echo
    echo "Plugins:"
    echo "  $vscode_dir"
    echo
    echo "Target:"
    echo "  $exts"
    echo

    mkdir -p "$exts"
    install_vsix_batch "$vscode_dir" "$exts" linux
    success "Plugins enabled for $label VS Code."
    echo
    echo "In UEFN, use: Edit > Editor Preferences > Verse Editor"
    echo "and enable Visual Studio Code support to start coding in Verse."
}

# Launch the Linux VS Code (selected target) with no workspace.
launch_vscode_linux() {
    local target
    target="$(get_vscode_target)"

    local tinfo
    if ! tinfo="$(linux_vscode_targets "$target")" || [[ -z "$tinfo" ]]; then
        error "No $target VS Code installation detected to launch."
        return 1
    fi
    IFS='|' read -r label exts reqflatpak launcher <<<"$tinfo"

    info "Launching $label VS Code..."
    # shellcheck disable=SC2086
    $launcher &
    disown 2>/dev/null || true
}

install_vscode_proton() {
    local vscode_dir="$1"

    local proton
    if ! proton="$(get_proton)"; then
        error "No Proton installation could be found."
        echo
        echo "Install Proton through Steam first."
        exit 1
    fi

    local prefix
    if ! prefix="$(cfg_get proton_prefix)"; then
        prefix="$BASE_DIR/proton-prefix"
        cfg_set proton_prefix "$prefix"
    fi
    local fake_steam="$prefix/fake-steam"

    mkdir -p "$prefix" "$fake_steam"

    export STEAM_COMPAT_DATA_PATH="$prefix"
    export STEAM_COMPAT_CLIENT_INSTALL_PATH="$fake_steam"

    # Boot/initialize prefix with wineboot if pfx does not exist yet
    if [[ ! -d "$prefix/pfx" ]]; then
        info "Initializing Proton prefix..."
        "$proton" run cmd.exe /c echo "Prefix initialized" >/dev/null 2>&1 || true
    fi

    # Target of VS Code inside the prefix
    local code_dir="$prefix/pfx/drive_c/users/steamuser/AppData/Local/Programs/Microsoft VS Code"
    local code_exe="$code_dir/Code.exe"

    echo
    echo "========================================="
    echo " Installing VS Code + Verse plugin"
    echo "========================================="
    echo
    echo "Plugins:"
    echo "  $vscode_dir"
    echo
    echo "Prefix:"
    echo "  $prefix"
    echo

    if [[ ! -f "$code_exe" ]]; then
        # The bundled VSCodeSetup*.exe installer cannot run under Wine/Proton
        # (FreeType font library error), so fetch the win32-x64 archive and
        # extract it natively instead.
        if ! command -v unzip &>/dev/null; then
            error "'unzip' is required to extract VS Code."
            exit 1
        fi

        local zip_url="https://code.visualstudio.com/sha/download?build=stable&os=win32-x64-archive"
        local tmp
        tmp="$(mktemp --suffix=.zip)"

        info "Downloading VS Code (win32-x64 archive)..."
        curl -fsSL -o "$tmp" "$zip_url" || {
            rm -f "$tmp"
            error "Failed to download VS Code."
            exit 1
        }

        info "Extracting VS Code into the prefix..."
        mkdir -p "$code_dir"
        unzip -q -o "$tmp" -d "$code_dir"
        rm -f "$tmp"

        # The archive has a single top-level folder (build hash); flatten it.
        local top
        top="$(find "$code_dir" -mindepth 1 -maxdepth 1 -type d -print -quit)"
        if [[ -n "$top" && -d "$top" && ! -e "$code_dir/Code.exe" ]]; then
            mv "$top"/* "$code_dir"/ 2>/dev/null
            rmdir "$top" 2>/dev/null
        fi

        if [[ ! -f "$code_exe" ]]; then
            error "VS Code did not appear in the prefix at the expected location:"
            echo "  $code_exe"
            exit 1
        fi
        success "VS Code installed."
    else
        info "VS Code already installed in the prefix. Re-running plugin install only."
    fi

    # Disable GPU acceleration and the Chromium sandbox so VS Code runs smoothly
    # under Wine/Proton without lagging the system. Persisted in argv.json so
    # these also apply when UEFN launches VS Code on its own.
    local user_dir="$prefix/pfx/drive_c/users/steamuser/.vscode"
    mkdir -p "$user_dir"

    cat > "$user_dir/argv.json" <<EOF
// Disable GPU acceleration and the Chromium sandbox to run smoothly under
// Wine/Proton without lagging the system.
{
    "disable-gpu": true,
    "disable-hardware-acceleration": true,
    "no-sandbox": true
}
EOF

    # Also disable the extension-host sandbox via a user setting. Merged into
    # settings.json so existing user settings are preserved.
    local code_settings="$prefix/pfx/drive_c/users/steamuser/AppData/Roaming/Code/User/settings.json"
    mkdir -p "$(dirname "$code_settings")"
    python3 - "$code_settings" <<'PYEOF'
import json, sys
p = sys.argv[1]
try:
    with open(p) as f:
        data = json.load(f)
except Exception:
    data = {}
data["app.enableSandbox"] = False
with open(p, "w") as f:
    json.dump(data, f, indent=4)
    f.write("\n")
PYEOF

    success "VS Code launch options applied (sandbox + GPU acceleration disabled)."

    # Install every bundled plugin (.vsix) directly, since Code.exe's CLI hangs
    # under Wine/Proton.
    install_vsix_batch "$vscode_dir" "$user_dir/extensions" windows

    success "VS Code + plugins installed into the Proton prefix."
    echo
    echo "In UEFN, use: Edit > Editor Preferences > Verse Editor"
    echo "and enable Visual Studio Code support to start coding in Verse."
}

# Launch the Windows VS Code (Code.exe) that lives inside the Proton prefix.
launch_vscode_proton() {
    local proton
    if ! proton="$(get_proton)"; then
        error "No Proton installation could be found."
        return 1
    fi

    local prefix
    if ! prefix="$(cfg_get proton_prefix)"; then
        prefix="$BASE_DIR/proton-prefix"
    fi
    local code_exe="$prefix/pfx/drive_c/users/steamuser/AppData/Local/Programs/Microsoft VS Code/Code.exe"

    if [[ ! -f "$code_exe" ]]; then
        error "VS Code is not installed in the Proton prefix."
        echo "  $code_exe"
        echo
        echo "Install it first with: $0 vscode-win"
        return 1
    fi

    local fake_steam="$prefix/fake-steam"
    mkdir -p "$fake_steam"

    export STEAM_COMPAT_DATA_PATH="$prefix"
    export STEAM_COMPAT_CLIENT_INSTALL_PATH="$fake_steam"

    info "Launching Windows VS Code under Proton..."
    "$proton" run "C:\\users\\steamuser\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe" &
    disown 2>/dev/null || true
}

###############################################################################
# Launch
###############################################################################

###############################################################################
# Launch
###############################################################################

launch_uefn() {
    choose_base_dir

    memory_recommendation
    ensure_livecd_memory

    ensure_auth

    # Check for game updates and update automatically before launching
    check_and_update_apps

    local proton
    if ! proton="$(get_proton || true)" || [[ -z "$proton" ]]; then
        error "No Proton installation could be found."
        echo
        echo "Install Proton through Steam first."
        exit 1
    fi

    local prefix
    if ! prefix="$(cfg_get proton_prefix || true)" || [[ -z "$prefix" ]]; then
        prefix="$BASE_DIR/proton-prefix"
        cfg_set proton_prefix "$prefix"
    fi
    local fake_steam="$prefix/fake-steam"

    mkdir -p "$prefix" "$fake_steam"

    export STEAM_COMPAT_DATA_PATH="$prefix"
    export STEAM_COMPAT_CLIENT_INSTALL_PATH="$fake_steam"

    local proton_root
    proton_root="$(dirname "$proton")"

    # Boot/initialize prefix with wineboot if pfx does not exist yet
    if [[ ! -d "$prefix/pfx" ]]; then
        info "Initializing Proton prefix..."
        "$proton" run cmd.exe /c echo "Prefix initialized" >/dev/null 2>&1 || true
    fi

    # Install MS Core Fonts
    install_core_fonts "$prefix"

    echo
    echo "========================================="
    echo " Launching UEFN"
    echo "========================================="
    echo
    echo "Proton:"
    echo "  $proton"
    echo
    echo "Prefix:"
    echo "  $prefix"
    echo
    echo "Logs:"
    echo "  displayed below"
    echo
    echo "-----------------------------------------"
    echo

    cd "$proton_root"

    local exe_path=""
    exe_path="$(find_uefn_exe "$BASE_DIR" || true)"
    if [[ -z "$exe_path" ]]; then
        exe_path="$BASE_DIR/Fortnite/Fortnite/FortniteGame/Binaries/Win64/UnrealEditorFortnite-Win64-Shipping.exe"
    fi

    # Load user launch options (Steam-style file with # comments).
    # Words before %command% wrap the Proton process (gamemoderun, mangohud),
    # words after it are forwarded to the game after the exe.
    ensure_launch_options_file

    local pre=() post=() section="pre"
    local arg
    while IFS= read -r arg || [[ -n "$arg" ]]; do
        case "$arg" in
            PRE)  section="pre" ;;
            POST) section="post" ;;
            *)
                if [[ "$section" == "pre" ]]; then
                    pre+=("$arg")
                else
                    post+=("$arg")
                fi
                ;;
        esac
    done < <(build_launch_args "$exe_path" || true)

    info "Launch options from:"
    echo "  $LAUNCH_OPTIONS_FILE"

    # Cleanup function executed on SIGINT (Ctrl+C), SIGTERM, or normal EXIT
    cleanup() {
        # Unbind traps immediately to prevent recursive execution on exit
        trap - SIGINT SIGTERM EXIT
        echo
        warn "Stopping Proton/Wine background processes..."

        local pfx="${prefix:-$BASE_DIR/proton-prefix}"
        local pr_root="${proton_root:-}"

        # Kill the wineserver associated with this prefix specifically
        if [[ -n "$pr_root" && -x "$pr_root/bin/wineserver" ]]; then
            WINEPREFIX="$pfx/pfx" "$pr_root/bin/wineserver" -k 2>/dev/null || true
        else
            WINEPREFIX="$pfx/pfx" wineserver -k 2>/dev/null || true
        fi

        # Kill any remaining child processes of this script
        kill 0 2>/dev/null || true
    }

    # Register trap handlers for Ctrl+C (INT), termination (TERM), and script exit (EXIT)
    trap cleanup INT TERM EXIT

    # Construct execution array
    local final_cmd=()
    if (( ${#pre[@]} > 0 )); then
        final_cmd+=("${pre[@]}")
    fi
    final_cmd+=("$proton" "run" "${post[@]}")

    echo "Launching via Proton:"
    echo "  ${final_cmd[*]}"
    echo

    "${final_cmd[@]}" &
    local proton_pid=$!

    # Check and set CPU limit based on current user
    local current_user="${USER:-$(whoami)}"

    if [[ "$current_user" == "livecd" ]]; then
        if command -v cpulimit >/dev/null 2>&1; then
            cpulimit -p "$proton_pid" -l 40 -b || true
            success "CPU Limiting ENABLED: User 'livecd' detected. Proton process (PID $proton_pid) capped at 40% CPU."
        else
            warn "User 'livecd' detected, but 'cpulimit' is not installed. CPU limiting skipped."
        fi
    else
        info "CPU Limiting DISABLED: Current user ('$current_user') is not 'livecd'."
    fi

    # Wait for Proton PID and capture exit code safely
    local exit_code=0
    wait "$proton_pid" 2>/dev/null || exit_code=$?

    # Disarm trap since process finished normally
    trap - SIGINT SIGTERM EXIT

    echo
    echo "-----------------------------------------"
    echo
    echo "UEFN exited with code: $exit_code"

    return "$exit_code"
}

###############################################################################
# Main menu
###############################################################################

main_menu() {
    while true; do
        clear

        echo "========================================="
        echo " Fortnite / UEFN Linux Installer"
        echo "========================================="
        echo
        echo "1) Install Fortnite + UEFN"
        echo "2) Launch UEFN (Checks for updates first)"
        echo "3) Find Proton"
        echo "4) VS Code (Linux): install plugins"
        echo "5) VS Code (Linux): launch"
        echo "6) VS Code (Windows/Proton): install"
        echo "7) VS Code (Windows/Proton): launch"
        echo "8) Memory / Swap (ZRAM)"
        echo "9) Check legendary"
        echo "10) Edit launch options"
        echo "11) Exit"
        echo
        echo "Launch options file:"
        echo "  $LAUNCH_OPTIONS_FILE"

        read -r -p "Select an option [1-11]: " choice || true

        case "$choice" in
            1)
                install_games
                read -r -p "Press Enter to continue..."
                ;;
            2)
                launch_uefn
                ;;
            3)
                echo

                cfg_delete proton_path
                local proton
                if proton="$(get_proton)"; then
                    success "Found Proton:"
                    echo "  $proton"
                else
                    error "No Proton installation found."
                fi

                echo
                read -r -p "Press Enter to continue..."
                ;;
            4)
                choose_base_dir
                local vscode_dir
                if vscode_dir="$(find_vscode_dir "$BASE_DIR")"; then
                    install_vscode_linux "$vscode_dir"
                else
                    error "Could not find the VS Code install folder."
                fi
                read -r -p "Press Enter to continue..."
                ;;
            5)
                launch_vscode_linux
                read -r -p "Press Enter to continue..."
                ;;
            6)
                choose_base_dir
                local vscode_dir
                if vscode_dir="$(find_vscode_dir "$BASE_DIR")"; then
                    install_vscode_proton "$vscode_dir"
                else
                    error "Could not find the VS Code install folder."
                fi
                read -r -p "Press Enter to continue..."
                ;;
            7)
                launch_vscode_proton
                read -r -p "Press Enter to continue..."
                ;;
            8)
                memory_menu
                ;;
            9)
                echo
                legendary_status
                read -r -p "Press Enter to continue..."
                ;;
            10)
                echo
                edit_launch_options
                read -r -p "Press Enter to continue..."
                ;;
            11)
                exit 0
                ;;
            *)
                warn "Invalid selection."
                sleep 1
                ;;
        esac
    done
}

###############################################################################
# Command-line mode
###############################################################################

case "${1:-}" in
    install)
        install_games
        ;;
    launch)
        launch_uefn
        ;;
    proton)
        get_proton
        ;;
    vscode-linux-install)
        choose_base_dir
        local vscode_dir
        if vscode_dir="$(find_vscode_dir "$BASE_DIR")"; then
            install_vscode_linux "$vscode_dir"
        else
            error "Could not find the VS Code install folder."
            exit 1
        fi
        ;;
    vscode-linux-launch)
        launch_vscode_linux
        ;;
    vscode-win-install)
        choose_base_dir
        local vscode_dir
        if vscode_dir="$(find_vscode_dir "$BASE_DIR")"; then
            install_vscode_proton "$vscode_dir"
        else
            error "Could not find the VS Code install folder."
            exit 1
        fi
        ;;
    vscode-win-launch)
        launch_vscode_proton
        ;;
    launch-options)
        edit_launch_options
        ;;
    legendary)
        legendary_status
        ;;
    memory)
        memory_status
        ;;
    livecd-memory)
        ensure_livecd_memory
        ;;
    zram)
        zram_setup "${2:-25}"
        ;;
    zram-off)
        zram_teardown
        ;;
    livecd-memory)
        ensure_livecd_memory
        ;;
    "")
        main_menu
        ;;
    *)
        echo "Usage:"
        echo "  $0                Interactive menu"
        echo "  $0 install        Install Fortnite + UEFN"
        echo "  $0 launch         Check updates and launch UEFN"
        echo "  $0 proton         Print detected Proton"
        echo "  $0 vscode-linux-install  Install Verse plugin into Linux VS Code"
        echo "  $0 vscode-linux-launch   Launch Linux VS Code"
        echo "  $0 vscode-win-install    Install Windows VS Code into Proton prefix"
        echo "  $0 vscode-win-launch     Launch Windows VS Code under Proton"
        echo "  $0 launch-options Edit the launch options file"
        echo "  $0 legendary      Check legendary version/hash status"
        echo "  $0 memory         Show memory + swap status and recommendation"
        echo "  $0 zram [PCT]     Set up ZRAM swap (default 25% of RAM)"
        echo "  $0 zram-off       Disable ZRAM swap"
        echo "  $0 livecd-memory  Auto-setup (15G zram + 50G USB swap)"
        exit 1
        ;;
esac
