#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Source shared helpers first (colours, config, version comparison, paths)
# then every feature module.  Each lib/*.sh file is self-contained but relies
# on the variables and helpers exported by common.sh.
source "$SCRIPT_DIR/lib/common.sh"
source "$SCRIPT_DIR/lib/launch_options.sh"
source "$SCRIPT_DIR/lib/legendary.sh"
source "$SCRIPT_DIR/lib/memory.sh"
source "$SCRIPT_DIR/lib/install_dir.sh"
source "$SCRIPT_DIR/lib/proton.sh"
source "$SCRIPT_DIR/lib/install_games.sh"
source "$SCRIPT_DIR/lib/uefn_exe.sh"
source "$SCRIPT_DIR/lib/vscode.sh"
source "$SCRIPT_DIR/lib/window_icon.sh"
source "$SCRIPT_DIR/lib/launcher.sh"
source "$SCRIPT_DIR/lib/menu.sh"

case "${1:-}" in
    install)
        install_games
        ;;
    launch)
        launch_uefn
        ;;
    proton)
        get_proton
        ;;
    vscode-linux-install)
        choose_base_dir
        if vscode_dir="$(find_vscode_dir "$BASE_DIR")"; then
            install_vscode_linux "$vscode_dir"
        else
            error "Could not find the VS Code install folder."
            exit 1
        fi
        ;;
    vscode-linux-launch)
        launch_vscode_linux
        ;;
    vscode-win-install)
        choose_base_dir
        if vscode_dir="$(find_vscode_dir "$BASE_DIR")"; then
            install_vscode_proton "$vscode_dir"
        else
            error "Could not find the VS Code install folder."
            exit 1
        fi
        ;;
    vscode-win-launch)
        launch_vscode_proton
        ;;
    launch-options)
        edit_launch_options
        ;;
    legendary)
        legendary_status
        ;;
    memory)
        memory_status
        ;;
    livecd-memory)
        ensure_livecd_memory
        ;;
    zram)
        zram_setup "${2:-25}"
        ;;
    zram-off)
        zram_teardown
        ;;
    "")
        main_menu
        ;;
    *)
        echo "Usage:"
        echo "  $0                Interactive menu"
        echo "  $0 install        Install Fortnite + UEFN"
        echo "  $0 launch         Check updates and launch UEFN"
        echo "  $0 proton         Print detected Proton"
        echo "  $0 vscode-linux-install  Install Verse plugin into Linux VS Code"
        echo "  $0 vscode-linux-launch   Launch Linux VS Code"
        echo "  $0 vscode-win-install    Install Windows VS Code into Proton prefix"
        echo "  $0 vscode-win-launch     Launch Windows VS Code under Proton"
        echo "  $0 launch-options Edit the launch options file"
        echo "  $0 legendary      Check legendary version/hash status"
        echo "  $0 memory         Show memory + swap status and recommendation"
        echo "  $0 zram [PCT]     Set up ZRAM swap (default 25% of RAM)"
        echo "  $0 zram-off       Disable ZRAM swap"
        echo "  $0 livecd-memory  Auto-setup (15G zram + 50G USB swap)"
        exit 1
        ;;
esac
